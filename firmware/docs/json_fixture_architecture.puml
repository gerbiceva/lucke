@startuml json_fixture_architecture
title Lucke Firmware — JSON-driven Fixture Build (proposed)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members

' ============================================================
'  LEGEND
'   <<new>>      : added by this refactor
'   <<changed>>  : existing class whose (de)serialization changes
'   <<retired>>  : compile-time fixture/output classes removed
'
'   JSON is the authoritative schema: the SAME document is the
'   transport payload, the NVS record, and the preset language.
'   A fixture is reconstructed entirely from JSON — no per-fixture C++.
' ============================================================

' ─────────────────────────────────────────
'  INTERFACES (unchanged contracts)
' ─────────────────────────────────────────
package "Interfaces" #DDEBF7 {
  interface Serializable {
    +toJson(JsonObject&) = 0
    +toJsonDoc() : JsonDocument
  }
  interface Deserializable {
    +fromJson(json : string) = 0
  }
  interface Output {
    +footprint() : uint16_t = 0
    +bind() = 0
    +update(src : uint8_t*) = 0
    +postupdate() = 0
    +setPreset(doc : JsonDocument&) = 0
    +toJson(obj : JsonObject&)
  }
  interface Input {
    +begin(universe) = 0
    +stop() = 0
    +poll(buff : uint8_t*) : bool
    +toJson(obj : JsonObject&)
  }
}

' ─────────────────────────────────────────
'  OUTPUT  (WS2815-native only on the JSON path)
' ─────────────────────────────────────────
package "Output" #E2EFDA {
  class Base {
    #m_uuid : uint16_t
    #m_size : uint16_t
    +footprint() : uint16_t
  }
  class "LEDBase<TDriver>" as LEDBase {
    #m_numLeds, m_pin
    #m_driver : TDriver
    #m_dstBuffer
  }
  class "LED1D<TDriver>" as LED1D {
    -m_numGroups
    +setPreset()  ' reads "num_groups"
    +footprint() = num_groups * 3
    +toJson()     ' emits shape/driver/pin/num_leds/num_groups
  }
  class LEDGridBase {
    -m_w, m_h
    -m_views[] : {x,y,cellW,cellH}
    +setPreset()  ' reads "width"/"height" (block count)
    +footprint() = SUM(vW*vH*3)
    +toJson()     ' <<changed>> now ALSO emits "strips" for round-trip
  }
  class WS2815Grid {
    +addStrip(pin, num_leds, xr, yr, cellW, cellH, horizontal)
  }
  class WS2815Driver {
    +init(num_leds, buffer, pin)  ' runtime pin
    +show()
  }

  class "Factory" as OutFactory <<new>> {
    +{static} create(obj : JsonObject&) : Output*
    .. switch ("shape","driver") ..
    ' "1d"   + "ws2815" -> new LED1D<WS2815Driver>(num_leds, pin)
    ' "grid" + "ws2815" -> new WS2815Grid(w,h) + addStrip per "strips"
    ' unknown -> log + nullptr (caller skips)
  }

  Base ..|> Output
  Base ..|> Serializable
  LEDBase --|> Base
  LED1D --|> LEDBase
  LEDGridBase --|> Base
  WS2815Grid --|> LEDGridBase
  LEDBase o--> WS2815Driver : TDriver
  OutFactory ..> LED1D : creates
  OutFactory ..> WS2815Grid : creates
}

' ─────────────────────────────────────────
'  CONFIG  (pure data)
' ─────────────────────────────────────────
package "Config" #FFF9E6 {
  class "Config::Fixture" as Cfg {
    +id, name, type
    +universe   ' BASE only — span is DERIVED
    +address
    +selectedPreset, numPresets
    +highlighted
    +toJson(obj)
  }
  Cfg ..|> Serializable
}

' ─────────────────────────────────────────
'  CORE — Fixture (generic, no subclasses)
' ─────────────────────────────────────────
class Fixture <<changed>> {
  -m_config : Config::Fixture
  -m_outputs : vector<Output*>
  -m_jsonPresets : JsonDocument
  -m_syncBuffers : vector<SyncBuffer>
  -m_buffer : vector<uint8_t>
  --
  +fromJson(json) : <<changed>> BUILDS outputs (via Factory)\n    + loads presets + config
  +toJson(obj)    : <<changed>> emits FULL definition\n    (config + outputs[] + presets)
  +setPreset(i)   ' positional: settings[k] -> outputs[k]
  +update()       ' stitches N universes into flat m_buffer
  +configJson() / presetsJson()  ' derived slices (for GET cmd)
  +wifiAnimation() ' <<changed>> generic buffer-walk, runtime-sized
}
Fixture ..|> Serializable
Fixture ..|> Deserializable
Fixture *--> Cfg
Fixture "1" o--> "*" Output : owns m_outputs
Fixture ..> OutFactory : builds outputs from "outputs"[]

' ─────────────────────────────────────────
'  HANDLERS
' ─────────────────────────────────────────
package "Handlers" #FCE4D6 {
  class FixtureHandler <<changed>> {
    -m_fixtures : vector<Fixture*>
    -m_storage : Storage
    -m_inputs : InputHandler&
    -m_nextId : uint8_t
    --
    +addFixture(defJson : string, factoryReset) : <<changed>>\n    (was addFixture<TFixture>())
    +get/exists/all()
    +setUniverse/Address/Preset/Name/highlight()
    +update()
    -persistFixture(id)   ' fix->toJsonDoc() -> NVS "fixtureN"
    -resubscribe(fix,...) ' numUni = (addr+footprint-1)/512 + 1
  }
  class InputHandler {
    -m_sources  : map<uni, Input>   ' demand-allocated
    -m_buffers  : map<uni, SyncBuffer>
    -m_refcount : map<uni, int>
    --
    +subscribe(uni) / unsubscribe(uni)  ' ref-counted
    +update() / reconnect()
    +toJson()  ' num_inputs = m_sources.size() (DERIVED, never stored)
  }
  note bottom of InputHandler
    THIS PHASE: subscribe() still hardcodes SacnSource.
    Input factory + per-universe protocol map = LATER step.
  end note

  FixtureHandler ..|> Serializable
  FixtureHandler ..|> Deserializable
  InputHandler ..|> Serializable
  FixtureHandler "1" o--> "*" Fixture : owns
  FixtureHandler --> InputHandler : subscribe / unsubscribe
}

package "Input" #F2EFFF {
  class SacnSource
  SacnSource ..|> Input
  InputHandler o--> "*" Input
}

' ─────────────────────────────────────────
'  UTILS
' ─────────────────────────────────────────
package "Utils" #EBF5EB {
  class Storage {
    +putString(key, json)
    +getString(key) : json
    +isKey(key) : bool
  }
  class SyncBuffer
}
FixtureHandler --> Storage : "fixtureN" <-> JSON
Fixture ..> SyncBuffer
InputHandler o--> "*" SyncBuffer
note bottom of Storage
  Storage encoding is ORTHOGONAL to schema:
  A) JSON text  (default today)
  B) MessagePack blob (serializeMsgPack) if NVS size bites
  C) hand-rolled binary  -- NOT recommended
end note

' ─────────────────────────────────────────
'  COMMANDS / BOOT
' ─────────────────────────────────────────
package "Commands" #F5E6FF {
  class CommandDispatcher
  class GetFixtureHandler
  class SetFixtureHandler
  class DescribeHandler
  CommandDispatcher o--> GetFixtureHandler
  CommandDispatcher o--> SetFixtureHandler
  CommandDispatcher o--> DescribeHandler
}
GetFixtureHandler ..> FixtureHandler : read (config/presets/definition)
SetFixtureHandler ..> FixtureHandler : mutate (universe/addr/preset/name)
DescribeHandler ..> FixtureHandler

class "Engine (main.cpp)" as Engine {
  +addFixture(defJson : string)  ' <<changed>> JSON string, not a C++ type
}
Engine --> FixtureHandler : addFixture(defJson, factoryReset)

' ─────────────────────────────────────────
'  RETIRED (compile-time construction)
' ─────────────────────────────────────────
package "RETIRED" #FFEEEE {
  class "Strip2815<N,Pin> / StripWS2815<N,Pin>" as R1 <<retired>>
  class "Grid2815_8x24 / BlinderTest" as R2 <<retired>>
  class "FastLED1D / FastLEDGrid / FastLED2D / FastLEDDriver" as R3 <<retired>>
  class "MakeJSON<N> (PresetMaker)" as R4 <<retired>>
}

@enduml


' ============================================================
@startuml json_fixture_build_sequence
title Build a fixture from JSON — boot & persistence flow
skinparam sequenceMessageAlign center

actor "main.cpp / UI" as Boot
participant "FixtureHandler" as FH
participant "Storage (NVS)" as NVS
participant "Fixture" as FX
participant "Output::Factory" as OF
participant "InputHandler" as IH

Boot -> FH : addFixture(defJson, factoryReset)
activate FH
FH -> FX : new Fixture()
FH -> NVS : isKey("fixtureN")?
alt stored definition exists && !factoryReset
  NVS --> FH : stored JSON (FULL definition)
  FH -> FX : fromJson(storedJson)
else first boot / factory reset
  FH -> FX : fromJson(defJson)
end

activate FX
note right of FX
  fromJson():
   1. parse identity + config (name, universe, address, presetIndex)
   2. load "presets" -> m_jsonPresets ; countPresets()
   3. for each obj in "outputs":
        Output::Factory::create(obj) -> Output*
   4. setPreset(selectedPreset)
end note
loop each "outputs"[] entry
  FX -> OF : create(outputObj)
  OF --> FX : Output*  (LED1D / WS2815Grid)
end
FX --> FH : built (outputs + presets ready)
deactivate FX

FH -> FX : getFootprint()
FH -> IH : subscribe(base .. base + numUni-1)
note right of FH : numUni = (address + footprint - 1)/512 + 1
IH --> FH : SyncBuffer[] (ref-counted)
FH -> FX : setSyncBuffers(bufs)

FH -> FX : toJsonDoc()  (full definition)
FX --> FH : JSON
FH -> NVS : putString("fixtureN", JSON)
note right of NVS : persisted record == rebuildable definition\n(round-trip closed)
deactivate FH

@enduml
