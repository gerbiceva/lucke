' ###################################################################
' #  INTERFACES  (namespace Interface)
' ###################################################################
package "Interface" <<Folder>> #EDE7F6 {

    interface CommandChannel <<iface>> {
        .. lifecycle ..
        +{abstract} begin() : void
        +stop() : void
        +{abstract} poll() : void
        +~CommandChannel()
    }

    interface Transport <<iface>> {
        +{abstract} send(data : const string&) : void
        +{abstract} readLine() : string
        +{abstract} isAvailable() : bool
        +{abstract} remoteAddress() : string
        +{abstract} close() : void
    }

    interface CommandHandler <<iface>> {
        +{abstract} handle(req : JsonDocument&, transport : Transport&) : void
    }

    interface Input <<iface>> {
        +{abstract} begin(universe : uint8_t) : void
        +{abstract} stop() : void
        +poll(buff : uint8_t*) : bool
        +toJson(obj : JsonObject&) : void
    }

    interface Output <<iface>> {
        +{abstract} footprint() : uint16_t {query}
        +{abstract} bind() : void
        +{abstract} update(src : uint8_t*) : void
        +{abstract} postupdate() : void
        +{abstract} setPreset(doc : const JsonDocument&) : void
        +toJson(doc : JsonObject&) : void
        +appendBasicInfo(doc : JsonDocument&) : void
    }

    interface Serializable <<iface>> {
        +{abstract} toJson(obj : JsonObject&) : void
        +toJsonDoc() : JsonDocument
    }

    interface Deserializable <<iface>> {
        +{abstract} fromJson(json : string) : void
    }
}

